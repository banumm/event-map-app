erDiagram
    CATEGORIES ||--o{ EVENTS : "имеет"
    CATEGORIES {
        string id PK "UUID"
        string name "NOT NULL, UNIQUE"
        string slug "UNIQUE (мигр. 0002)"
        datetime created_at "NOT NULL"
    }
    EVENTS {
        string id PK "UUID"
        string title "NOT NULL, CHECK 2..100"
        string description "NOT NULL, CHECK <=2000"
        float lat "NOT NULL, CHECK -90..90"
        float lng "NOT NULL, CHECK -180..180"
        datetime starts_at "NOT NULL"
        string category_id FK "FK -> categories.id"
        string organizer_id "NOT NULL"
        datetime created_at "NOT NULL"
        datetime updated_at "NOT NULL"
    }