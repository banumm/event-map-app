# ===================================================================== #
# Events Service — примеры запросов (ПР2–ПР4)
# Формат: VS Code REST Client.
#
# Запуск:
#   users-service:      python manage.py migrate && python manage.py runserver 8000
#   events-service:     alembic upgrade head && python app.py
#
# JWT выдаёт users-service. Изменение событий доступно ролям organizer/admin.
# ===================================================================== #

@users = http://localhost:8000
@host = http://localhost:5001

# Токены для проверки 403/204 задайте вручную после /auth/login
# (admin создаётся командой python manage.py create_admin).
@userToken = <JWT роли user>
@otherOrganizerToken = <JWT другого organizer>
@adminToken = <JWT роли admin>

### 0. Регистрация организатора (если ещё нет)
POST {{users}}/auth/register
Content-Type: application/json

{
  "username": "organizer1",
  "email": "organizer1@example.com",
  "password": "StrongPass123",
  "role": "organizer"
}

### 1. Вход организатора -> access_token
# @name login
POST {{users}}/auth/login
Content-Type: application/json

{
  "username": "organizer1",
  "password": "StrongPass123"
}

### 2. Кто я (проверка токена)
GET {{users}}/auth/me
Authorization: Bearer {{login.response.body.access_token}}

### 3. Health check events-service
GET {{host}}/health

### 4. Список событий (публично) -> 200
GET {{host}}/events

### 5. Создание события организатором -> 201
# @name create
POST {{host}}/events
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "title": "Концерт в парке",
  "description": "Живая музыка на открытой площадке",
  "lat": 55.7558,
  "lng": 37.6176,
  "starts_at": "2026-10-01T19:00:00Z",
  "category": "concert"
}

### 6. Создание без токена -> 401
# {"error":{"code":"Unauthorized","message":"Требуется аутентификация","details":[]}}
POST {{host}}/events
Content-Type: application/json

{
  "title": "Без токена",
  "description": "Запрос должен быть отклонён",
  "lat": 55.75,
  "lng": 37.61,
  "starts_at": "2026-10-01T19:00:00Z",
  "category": "concert"
}

### 7. Создание с ролью user -> 403
# Получите токен обычного пользователя через /auth/login.
# {"error":{"code":"Forbidden","message":"Недостаточно прав...","details":[...]}}
POST {{host}}/events
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Пользователь не организатор",
  "description": "Запрос должен быть отклонён",
  "lat": 55.75,
  "lng": 37.61,
  "starts_at": "2026-10-01T19:00:00Z",
  "category": "concert"
}

### 8. Получение одной записи -> 200
GET {{host}}/events/{{create.response.body.id}}

### 9. Несуществующая запись -> 404
# {"error":{"code":"NotFound","message":"Мероприятие не найдено","details":[...]}}
GET {{host}}/events/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee

### 10. Ошибка валидации -> 400
# {"error":{"code":"ValidationError","message":"Ошибка валидации","details":[...]}}
POST {{host}}/events
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "description": "Без названия",
  "lat": "не-число",
  "lng": 999,
  "starts_at": "не дата",
  "category": "футбол"
}

### 11. Некорректный JSON -> 400
POST {{host}}/events
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{ это не json

### 12. Полное обновление своего события -> 200
PUT {{host}}/events/{{create.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "title": "Концерт в парке (обновлено)",
  "description": "Живая музыка, перенесено на осень",
  "lat": 55.7558,
  "lng": 37.6176,
  "starts_at": "2026-10-05T19:00:00Z",
  "category": "concert"
}

### 13. Частичное обновление -> 200
PATCH {{host}}/events/{{create.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{
  "category": "meetup"
}

### 14. Чужое событие -> 403
PUT {{host}}/events/{{create.response.body.id}}
Authorization: Bearer {{otherOrganizerToken}}
Content-Type: application/json

{
  "title": "Чужое событие",
  "description": "Организатор не владелец",
  "lat": 55.75,
  "lng": 37.61,
  "starts_at": "2026-10-05T19:00:00Z",
  "category": "concert"
}

### 15. Удаление владельцем -> 204
DELETE {{host}}/events/{{create.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}

### 16. Удаление администратором -> 204
# Токен admin получается через /auth/login или management-команду create_admin.
DELETE {{host}}/events/{{create.response.body.id}}
Authorization: Bearer {{adminToken}}
