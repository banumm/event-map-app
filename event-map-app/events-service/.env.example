# Строка подключения к реляционной базе данных (ПР3).
# Задаётся ТОЛЬКО через переменные окружения. Скопируйте в .env и заполните.

# SQLite (по умолчанию, файл events.db в каталоге сервиса):
DATABASE_URL=sqlite:///./events.db

# PostgreSQL (если установлена и создана БД event_map):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/event_map

# Общий секрет JWT — должен совпадать с users-service.
JWT_SECRET=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=event-map-users-service

FLASK_DEBUG=0
# Кэш GET /events и GET /events/{id} (ПР6): время жизни записи и окно,
# в котором просроченная запись отдаётся при недоступной БД. 0 — кэш выключен.
EVENTS_CACHE_TTL_SECONDS=60
EVENTS_CACHE_STALE_SECONDS=300

# Тайм-аут подключения к PostgreSQL, с (ПР7)
DB_CONNECT_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
