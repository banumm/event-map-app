# Переменные окружения для docker compose (ПР7).
# Скопируйте в .env и заполните. Реальный .env НЕ коммитится (.gitignore).

# PostgreSQL (контейнер db)
POSTGRES_USER=
# Только латиница и цифры: значение подставляется в строку подключения.
POSTGRES_PASSWORD=

# Общий секрет подписи JWT для всех сервисов (не короче 32 символов)
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# users-service (Django)
DJANGO_SECRET_KEY=
# Необязательно: администратор создаётся при первом запуске
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
AUTH_RATE_LIMIT=10

# events-service: кэш списка событий (ПР6)
EVENTS_CACHE_TTL_SECONDS=60
EVENTS_CACHE_STALE_SECONDS=300

# attendance-service → events-service
EVENTS_SERVICE_TIMEOUT_SECONDS=2
EVENTS_SERVICE_RETRIES=2

LOG_LEVEL=INFO
