# Скопируйте в .env и задайте собственные значения.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Общий секрет для подписи и проверки JWT во всех сервисах.
JWT_SECRET=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=event-map-users-service
JWT_EXPIRES_MINUTES=60

# Ограничение частоты запросов на /auth/login и /auth/register (на IP).
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# База данных (ПР7). Пусто — локальный SQLite db.sqlite3;
# в docker compose: postgresql://user:password@db:5432/users_db
DATABASE_URL=
LOG_LEVEL=INFO
