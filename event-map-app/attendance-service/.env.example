# Общий секрет JWT — должен совпадать с users-service.
JWT_SECRET=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=event-map-users-service

FLASK_DEBUG=0

# Проверка события в events-service перед отметкой участия.
# Пусто — проверка выключена (локальный запуск без events-service).
EVENTS_SERVICE_URL=http://localhost:5001
EVENTS_SERVICE_TIMEOUT_SECONDS=2
EVENTS_SERVICE_RETRIES=2
LOG_LEVEL=INFO
